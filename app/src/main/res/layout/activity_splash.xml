<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8F0"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- LOGO -->
    <ImageView
        android:id="@+id/ivSplashLogo"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:src="@drawable/ic_logo"
        android:contentDescription="Logo OopsReport"
        android:scaleType="centerInside" />

    <!-- JUDUL APLIKASI -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="OOPSREPORT"
        android:textColor="#1E1E2A"
        android:textSize="28sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.1" />

    <!-- TAGLINE -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Oops Rusak? Lapor Aja!"
        android:textColor="#6B6B7B"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- LOADER (Warna Biru Sesuai Tema) -->
    <ProgressBar
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:indeterminate="true"
        android:indeterminateTint="#8A9BFF" />

</LinearLayout>