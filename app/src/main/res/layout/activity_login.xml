<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cream"
    android:orientation="vertical"
    android:padding="30dp"
    android:gravity="center_horizontal">

    <FrameLayout
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginTop="60dp"
        android:background="@drawable/bg_neo_brutalist_logo"
        android:padding="12dp">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_logo"
            android:contentDescription="Logo" />
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="OOPSREPORT"
        android:textColor="@color/black"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Oops Rusak? Lapor Aja!"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:layout_marginBottom="40dp"/>

    <EditText
        android:id="@+id/etEmail"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:background="@drawable/bg_neo_brutalist_edittext"
        android:hint="Email"
        android:paddingHorizontal="16dp"
        android:textColor="@color/black"
        android:layout_marginBottom="16dp"
        android:inputType="textEmailAddress"/>

    <EditText
        android:id="@+id/etPassword"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:background="@drawable/bg_neo_brutalist_edittext"
        android:hint="Password"
        android:paddingHorizontal="16dp"
        android:textColor="@color/black"
        android:layout_marginBottom="24dp"
        android:inputType="textPassword"/>

    <Button
        android:id="@+id/btnLogin"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:background="@drawable/bg_neo_brutalist_button_blue"
        android:text="LOGIN"
        android:textColor="@color/white"
        android:textStyle="bold"
        app:backgroundTint="@null"
        xmlns:app="http://schemas.android.com/apk/res-auto"/>

    <TextView
        android:id="@+id/tvRegister"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Oops Belum punya akun? Yuk Daftar!"
        android:textColor="@color/btn_blue"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginTop="20dp"/>

</LinearLayout>